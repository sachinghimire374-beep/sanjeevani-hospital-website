# Copy this file to .env and fill in real values before deploying.

# Port the server listens on (most hosts set this automatically — leave as-is)
PORT=3000

# Secret used to sign admin login tokens — set this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_string

# First admin account, created automatically the first time the server starts
ADMIN_USERNAME=sanjeevanihospitalpokhara@gmail.com
ADMIN_PASSWORD=Hospital@2026

# Admin email address (used for system messages)
ADMIN_EMAIL=sanjeevanihospitalpokhara@gmail.com

# Hospital contact phone (shown in emails sent to patients)
HOSPITAL_PHONE=+977 61-578161

# ── Email / SMTP ────────────────────────────────────────────────
# Emails are sent in three situations:
#   1. When a patient submits a booking → "Request received" email
#   2. When admin approves a booking   → "Appointment confirmed" email
#   3. When admin rejects a booking    → "Could not confirm" email
#
# For Gmail: enable 2-Step Verification on the account, then visit
# myaccount.google.com/apppasswords → create an App Password (16 chars, no spaces)
# and paste it as SMTP_PASS below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=Sanjeevani Hospital <your@gmail.com>
